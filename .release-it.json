{
  "$schema": "./node_modules/release-it/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCommits": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": true
  },
  "npm": {
    "publish": false,
    "versionArgs": ["--ignore-scripts"]
  }
}
